{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rustkins-Project/RustkinsDocs/blob/main/schemas/adr.schema.json",
  "title": "Rustkins ADR frontmatter",
  "description": "Validation du frontmatter YAML parsé en objet JSON ; ne valide pas les revues GitHub.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "topics",
    "applies_to",
    "decided_at",
    "approved_by",
    "supersedes",
    "related_work_items",
    "references"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ADR-[0-9]{4,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "superseded"
      ]
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "applies_to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(V[0-9]+|all)$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "decided_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "approved_by": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ADR-[0-9]{4,}$"
      },
      "uniqueItems": true
    },
    "related_work_items": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approved_by": {
            "minItems": 1
          },
          "decided_at": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  ]
}
