erDiagram
    direction LR

    USER {
        uuid id PK
        string email
        string username
        string password_hash
        string role_global
        bool is_active
        datetime created_at
        datetime updated_at
        datetime last_login_at
    }

    USER_REFRESH_TOKEN {
        uuid id PK
        uuid user_id FK
        string token_hash
        datetime created_at
        datetime expires_at
        datetime revoked_at
        string user_agent
        string ip_address
    }

    PROJECT {
        uuid id PK
        string name
        string slug
        string repository_url
        string default_branch
        bool is_active
        datetime created_at
        datetime updated_at
    }

    PROJECT_MEMBER {
        uuid id PK
        uuid project_id FK
        uuid user_id FK
        string role
        datetime created_at
    }

    API_TOKEN {
        uuid id PK
        uuid project_id FK
        string name
        string token_prefix
        string token_hash
        string scopes
        bool revoked
        datetime created_at
        datetime expires_at
        datetime last_used_at
    }

    WEBHOOK_CONFIG {
        uuid id PK
        uuid project_id FK
        string provider
        string encrypted_secret
        bool enabled
        datetime created_at
        datetime updated_at
    }

    WEBHOOK_DELIVERY {
        uuid id PK
        uuid project_id FK
        uuid webhook_config_id FK
        string external_delivery_id
        string event_type
        string commit_sha
        string branch
        string status
        string error_message
        datetime received_at
        datetime processed_at
    }

    PIPELINE {
        uuid id PK
        uuid project_id FK
        string name
        string yaml_path
        bool is_active
        datetime created_at
        datetime updated_at
    }

    PIPELINE_VERSION {
        uuid id PK
        uuid pipeline_id FK
        string git_sha
        string yaml_hash
        text yaml_content
        string validation_status
        json validation_errors_json
        datetime created_at
    }

    PIPELINE_VERSION_JOB {
        uuid id PK
        uuid pipeline_version_id FK
        string job_key
        string name
        string image
        string run_if
        bool optional
        int cpu_limit_milli
        int memory_limit_mb
        int timeout_seconds
        int order_index
    }

    PIPELINE_VERSION_STEP {
        uuid id PK
        uuid pipeline_version_job_id FK
        string step_key
        string name
        string command
        int order_index
        bool continue_on_error
    }

    PIPELINE_VERSION_JOB_DEPENDENCY {
        uuid id PK
        uuid pipeline_version_job_id FK
        uuid depends_on_pipeline_version_job_id FK
    }

    PIPELINE_RUN {
        uuid id PK
        uuid project_id FK
        uuid pipeline_id FK
        uuid pipeline_version_id FK
        uuid triggered_by_user_id FK
        uuid webhook_delivery_id FK
        uuid cancelled_by_user_id FK
        string trigger_type
        string status
        string branch
        string commit_sha
        string commit_message
        string author_name
        string author_email
        datetime created_at
        datetime started_at
        datetime finished_at
        datetime cancelled_at
        string cancel_reason
    }

    JOB_RUN {
        uuid id PK
        uuid pipeline_run_id FK
        uuid pipeline_version_job_id FK
        uuid worker_node_id FK
        string status
        string idempotency_key
        int attempt_count
        int max_attempts
        datetime queued_at
        datetime started_at
        datetime finished_at
        datetime cancelled_at
        string cancel_reason
        int exit_code
    }

    JOB_RUN_DEPENDENCY {
        uuid id PK
        uuid job_run_id FK
        uuid depends_on_job_run_id FK
    }

    JOB_RUN_ATTEMPT {
        uuid id PK
        uuid job_run_id FK
        uuid worker_node_id FK
        int attempt_number
        string status
        string error_message
        datetime started_at
        datetime finished_at
    }

    STEP_RUN {
        uuid id PK
        uuid job_run_id FK
        uuid pipeline_version_step_id FK
        string status
        int exit_code
        datetime started_at
        datetime finished_at
    }

    WORKER_NODE {
        uuid id PK
        string name
        string hostname
        string status
        int total_cpu_milli
        int total_memory_mb
        int reserved_cpu_milli
        int reserved_memory_mb
        datetime last_heartbeat_at
        datetime created_at
    }

    JOB_LOG_STREAM {
        uuid id PK
        uuid job_run_id FK
        string storage_key
        int last_sequence
        datetime created_at
        datetime updated_at
    }

    LOG_EVENT {
        int sequence
        string stream
        string content
        datetime emitted_at
    }

    ARTIFACT {
        uuid id PK
        uuid pipeline_run_id FK
        uuid job_run_id FK
        string name
        string archive_name
        string storage_key
        int size_bytes
        string content_type
        string checksum_sha256
        datetime created_at
        datetime expires_at
        datetime deleted_at
        bool deleted
    }

    ARTIFACT_RETENTION_POLICY {
        uuid id PK
        uuid project_id FK
        int default_retention_days
        int max_retention_days
        int max_artifact_size_mb
        int max_run_artifacts_size_mb
        datetime created_at
        datetime updated_at
    }

    RUN_EVENT {
        uuid id PK
        uuid pipeline_run_id FK
        uuid job_run_id FK
        string event_type
        string message
        datetime created_at
    }

    OUTBOX_MESSAGE {
        uuid id PK
        uuid pipeline_run_id FK
        uuid job_run_id FK
        string exchange
        string routing_key
        string event_type
        json payload_json
        string status
        int attempts
        datetime next_attempt_at
        string last_error
        datetime created_at
        datetime published_at
    }

    USER ||--o{ USER_REFRESH_TOKEN : has
    USER ||--o{ PROJECT_MEMBER : belongs_to

    PROJECT ||--o{ PROJECT_MEMBER : has
    PROJECT ||--o{ API_TOKEN : owns
    PROJECT ||--o{ WEBHOOK_CONFIG : owns
    PROJECT ||--o{ PIPELINE : owns
    PROJECT ||--o{ PIPELINE_RUN : has
    PROJECT ||--o{ ARTIFACT_RETENTION_POLICY : defines

    WEBHOOK_CONFIG ||--o{ WEBHOOK_DELIVERY : receives

    PIPELINE ||--o{ PIPELINE_VERSION : has
    PIPELINE ||--o{ PIPELINE_RUN : executes

    PIPELINE_VERSION ||--o{ PIPELINE_VERSION_JOB : defines
    PIPELINE_VERSION_JOB ||--o{ PIPELINE_VERSION_STEP : contains
    PIPELINE_VERSION_JOB ||--o{ PIPELINE_VERSION_JOB_DEPENDENCY : has
    PIPELINE_VERSION_JOB_DEPENDENCY }o--|| PIPELINE_VERSION_JOB : depends_on

    PIPELINE_VERSION ||--o{ PIPELINE_RUN : used_by

    USER ||--o{ PIPELINE_RUN : triggers
    USER ||--o{ PIPELINE_RUN : cancels

    WEBHOOK_DELIVERY ||--o{ PIPELINE_RUN : triggers

    PIPELINE_RUN ||--o{ JOB_RUN : contains
    PIPELINE_VERSION_JOB ||--o{ JOB_RUN : instantiated_by

    JOB_RUN ||--o{ STEP_RUN : contains
    PIPELINE_VERSION_STEP ||--o{ STEP_RUN : instantiated_by

    JOB_RUN ||--o{ JOB_RUN_DEPENDENCY : has
    JOB_RUN_DEPENDENCY }o--|| JOB_RUN : depends_on

    WORKER_NODE ||--o{ JOB_RUN : executes
    WORKER_NODE ||--o{ JOB_RUN_ATTEMPT : executes

    JOB_RUN ||--o{ JOB_RUN_ATTEMPT : has

    JOB_RUN ||--o| JOB_LOG_STREAM : writes
    JOB_RUN ||--o{ LOG_EVENT : emits

    PIPELINE_RUN ||--o{ ARTIFACT : produces
    JOB_RUN ||--o{ ARTIFACT : produces

    PIPELINE_RUN ||--o{ RUN_EVENT : has
    JOB_RUN ||--o{ RUN_EVENT : concerns

    PIPELINE_RUN ||--o{ OUTBOX_MESSAGE : emits
    JOB_RUN ||--o{ OUTBOX_MESSAGE : dispatches
