{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rustkins-Project/RustkinsDocs/blob/main/docs/schemas/knowledge.schema.json",
  "title": "Rustkins knowledge frontmatter",
  "description": "Validation du frontmatter YAML parsé en objet JSON ; pas de revue humaine requise.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "type",
    "status",
    "topics",
    "applies_to",
    "verified_at",
    "references"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^KNOW-[0-9]{4,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "troubleshooting",
        "technical-note",
        "pattern",
        "best-practice",
        "lesson",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "verified",
        "outdated"
      ]
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "applies_to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(V[0-9]+|all)$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "verified_at": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  ]
}
